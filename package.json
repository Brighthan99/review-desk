{
  "name": "review-desk",
  "displayName": "Review Desk",
  "description": "Review code changes and pull requests with AI notes beside the code: pick lines, read the explanation, ask follow-ups, draft and post PR comments. Runs your own signed-in Claude Code or Codex (ChatGPT).",
  "version": "0.1.0",
  "preview": true,
  "publisher": "brighthan99",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Brighthan99/review-desk.git"
  },
  "bugs": {
    "url": "https://github.com/Brighthan99/review-desk/issues"
  },
  "homepage": "https://github.com/Brighthan99/review-desk#readme",
  "private": true,
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "code review",
    "pull request",
    "github",
    "diff",
    "explain code",
    "claude",
    "claude code",
    "codex",
    "chatgpt",
    "ai"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "reviewDesk.start",
        "title": "Start Review",
        "category": "Review Desk"
      },
      {
        "command": "reviewDesk.startWithBase",
        "title": "Start Review Against Branch…",
        "category": "Review Desk"
      },
      {
        "command": "reviewDesk.compare",
        "title": "Compare…",
        "category": "Review Desk",
        "icon": "$(git-compare)"
      },
      {
        "command": "reviewDesk.changeBase",
        "title": "Change Base…",
        "category": "Review Desk",
        "icon": "$(arrow-left)"
      },
      {
        "command": "reviewDesk.changeRight",
        "title": "Change Compare Side…",
        "category": "Review Desk",
        "icon": "$(arrow-right)"
      },
      {
        "command": "reviewDesk.compareFrom",
        "title": "Compare from Here (Base)",
        "category": "Review Desk",
        "icon": "$(arrow-left)"
      },
      {
        "command": "reviewDesk.compareTo",
        "title": "Compare up to Here (Compare Side)",
        "category": "Review Desk",
        "icon": "$(arrow-right)"
      },
      {
        "command": "reviewDesk.changeLanguage",
