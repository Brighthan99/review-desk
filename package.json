        "title": "Show More Commits",
        "category": "Review Desk"
      },
      {
        "command": "reviewDesk.refreshWorktrees",
        "title": "Refresh Worktrees",
        "category": "Review Desk",
        "icon": "$(refresh)"
      },
      {
        "command": "reviewDesk.copyWorktreeRemove",
        "title": "Copy Remove Command",
        "category": "Review Desk",
        "icon": "$(copy)"
      },
      {
        "command": "reviewDesk.removeWorktree",
        "title": "Remove Worktree",
        "category": "Review Desk",
